{
  "app-id": "org.arasaka.usb",
  "runtime": "org.gnome.Platform",
  "runtime-version": "50",
  "sdk": "org.gnome.Sdk",
  "sdk-extensions": ["org.freedesktop.Sdk.Extension.rust-stable"],
  "build-options": {
    "append-path": "/usr/lib/sdk/rust-stable/bin",
    "build-args": ["--share=network"]
  },
  "command": "arasaka-usb",
  "finish-args": [
    "--share=network",
    "--socket=x11",
    "--socket=wayland",
    "--device=all",
    "--filesystem=host"
  ],
  "modules": [
    {
      "name": "arasaka-usb",
      "buildsystem": "simple",
      "build-commands": [
        "cargo build --release --locked",
        "install -Dm755 target/release/arasaka-usb /app/bin/arasaka-usb",
        "install -Dm644 icons/arasaka-usb.svg /app/share/icons/hicolor/scalable/apps/arasaka-usb.svg",
        "install -Dm644 icons/arasaka-usb.png /app/share/icons/hicolor/128x128/apps/arasaka-usb.png",
        "install -Dm644 packaging/org.arasaka.usb.desktop /app/share/applications/org.arasaka.usb.desktop",
        "install -Dm644 packaging/org.arasaka.usb.metainfo.xml /app/share/metainfo/org.arasaka.usb.metainfo.xml"
      ],
      "sources": [
        {
          "type": "dir",
          "path": ".."
        }
      ]
    }
  ]
}
